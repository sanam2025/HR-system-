# Base URL of the Masar-HR Laravel API, including the trailing slash and the
# `/api` prefix (this must match the `{{base_url}}` variable used in the
# Masar-HR Postman collection).
VITE_API_BASE_URL=http://masarhr.alwaysdata.net/api/

# Milliseconds before an idle request is aborted.
VITE_API_TIMEOUT_MS=15000
